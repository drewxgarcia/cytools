# Compiled python or sage files
*.pyc
__pycache__
*.sage.py

# Jupyter notebooks (if you want to add one use the --force option)
*.ipynb
!demos/*.ipynb
.ipynb_checkpoints

# Data files
*.dat
*.zip
*.rar
*.tar*

# Mosek license
*.lic

# Python package build files
/build/
/dist/
/*.egg-info/

# Local environments and tool state
/.venv/
/.pytest_cache/
/.ruff_cache/
/.ty_cache/
/.benchmarks/
/.coverage
/htmlcov/

# Local benchmark output. Curated baselines under benchmarks/artifacts remain
# versioned; ad-hoc pytest-benchmark output does not.
/benchmark-results/

# testing
private.py
examples

# build logs
build.log
